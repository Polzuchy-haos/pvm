// Проверка сахара, который ничего не стоит в кодогенерации:
// - составные присваивания (+= -= *= /= &= |= ^= <<= >>=) и ++/--
//   (десахарируются в парсере в обычные "name = name op rhs", см. hlc/parser.cpp)
// - do { ... } while (...);  (тело выполняется минимум один раз)
// - sizeof(array)            (сворачивается в PUSH <размер> на этапе компиляции)

int history[8];
volatile int OUT @ 0x4007;      // выходной регистр: что сюда записано, видно в трассе pvmsim

int SumWithSugar() {
    int i;
    int sum;
    i = 0;
    sum = 0;

    // do-while: тело должно отработать хотя бы раз, даже если условие сразу ложно
    do {
        sum = sum + 1;
    } while (0);           // sum == 1 после этого

    while (i < sizeof(history)) {
        sum += i;           // составное присваивание
        i++;                // постфиксный инкремент
        history[i - 1] = 1; // просто чтобы history считался использованным
    }
    // sum == 1 + (0+1+2+...+7) == 1 + 28 == 29

    sum <<= 1;              // 58
    sum -= 2;                // 56
    return sum;
}

void main() {
    OUT = SumWithSugar();   // ожидаем "STORE 0x4007 -> 56"
}
