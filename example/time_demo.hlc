// Демонстрация lib/time.hlc. Свободно бегущий счётчик в pvmsim (Svc_Tick)
// стартует в -6 (= беззнаковые 65530, т.е. "за 6 тиков до переполнения") и
// прибавляет 10 за каждый вызов — так что уже первый Time_Elapsed()
// пересекает границу переполнения 65535 -> 0.
import time;

int OLD_TICK;
int ELAPSED;

void main() {
    OLD_TICK = Time_GetTick();      // -6
    ELAPSED = Time_Elapsed(OLD_TICK); // ожидаем 10, несмотря на переполнение
}
