// Классический "blink": состояние светодиода лежит на MMIO-адресе 0x4000
// (тот же usrsect, что и REG_EX в counter.hlc), переключается в бесконечном
// цикле с программной задержкой. В отличие от остальных примеров эта
// программа никогда не доходит до HALT — как и настоящая прошивка мигалки,
// она всегда крутится в while(1), поэтому она не подключена к ctest'у
// (там проверяется именно достижение HALT).

volatile int LED @ 0x4000;

// int в этом языке — 16 бит (максимум ~32767), поэтому один счётчик не даёт
// заметной глазом задержки; используем вложенный цикл (200*200 = 40000
// итераций внутреннего тела). Если на вашем МК мигание всё ещё слишком
// быстрое/медленное — подберите константы 200 под реальную скорость
// исполнения интерпретатора.
void delay() {
    int i;
    int j;
    for (i = 0; i < 200; i = i + 1) {
        for (j = 0; j < 200; j = j + 1) {
        }
    }
}

void main() {
    LED = 0;
    while (1) {
        LED = LED ^ 1;  // переключить состояние светодиода
        delay();
    }
}
