// Классический "blink": состояние светодиода лежит на MMIO-адресе 0x4000
// (тот же usrsect, что и REG_EX в counter.hlc), переключается в бесконечном
// цикле. В отличие от остальных примеров эта программа никогда не доходит
// до HALT — как и настоящая прошивка мигалки, она всегда крутится в
// while(1), поэтому она не подключена к ctest'у (там проверяется именно
// достижение HALT).
//
// Задержка — Time_Delay из lib/time.hlc, а не ручной счётный цикл: так это
// стоит писать на настоящем МК с реальным таймером за SVC #0 — Time_Delay
// будет ждать реальные тики, без единой правки в этом коде. На
// desktop-симуляторе Svc_Tick (simulator/pvmsim.c) — синтетический счётчик,
// нужный для детерминированного теста переполнения в example/time_demo.hlc,
// а не настоящее время, поэтому здесь длительность задержки не соответствует
// реальным секундам.
import time;

volatile int LED @ 0x4000;

void main() {
    LED = 0;
    while (1) {
        LED = LED ^ 1;  // переключить состояние светодиода
        Time_Delay(1);
    }
}
