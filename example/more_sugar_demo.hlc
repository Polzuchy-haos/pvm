// Проверка: тернарный оператор (cond ? a : b), символьные литералы ('A'),
// множественное объявление переменных в одной строке (int a, b, c;)
// и инициализация массива списком (int arr[N] = {..};).

int scores[4] = {10, 20, 'A', -5};   // 'A' == 65; список-инициализатор массива
int a, b = 3, c;                     // множественное объявление глобальных в одной строке

int ClassifyScore(int s) {
    int i, sum, biggest;             // множественное объявление локальных
    i = 0;
    sum = 0;
    biggest = scores[0];
    while (i < sizeof(scores)) {
        sum += scores[i];
        biggest = scores[i] > biggest ? scores[i] : biggest;  // тернарный оператор
        i++;
    }
    return s > 0 ? sum : biggest;    // тернарный оператор, обе ветки реально используются
}

void main() {
    a = 1;
    c = a + b;                                     // 1 + 3 = 4
    svc(1, ClassifyScore(c) + ClassifyScore(-c));   // 90 (сумма) + 65 (максимум) = 155
}
