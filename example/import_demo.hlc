// Демонстрация "import": mathlib.hlc подключается по аналогии с .import
// из .pvms — раскрывается на уровне токенов ещё до разбора, так что cube()
// и max2() видны здесь как обычные функции этого же файла.
import mathlib;

int RESULT;

void main() {
    RESULT = cube(3) + max2(10, 4);  // 27 + 10 = 37
}
