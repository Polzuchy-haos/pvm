# Проверка SVC: окружение pvmsim (simulator/pvmenv.c) регистрирует SVC #2 =
# "сложить два числа со стека" (Svc_Add) — это демонстрация вызова в Си-код
# с аргументами и возвращаемым значением. Результат пишется в выходной
# регистр 0x4007, его видно в трассе pvmsim ("STORE 0x4007 -> 7").
.entry main

main:
  PUSH 3    # первый аргумент
  PUSH 4    # второй аргумент
  PUSH 2    # номер вызова: SVC #2 (add)
  SVC
  STORE 0x4007
  HALT
