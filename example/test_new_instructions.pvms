# Проверка новых инструкций: LOADI/STOREI (косвенный доступ), HALT и битовые операции.
.entry main
.const RAM_PTR0 0
.const RAM_PTR1 1

main:
  PUSH 6
  PUSH 3
  AND      # 6 & 3 = 2
  POP

  PUSH 6
  PUSH 3
  OR       # 6 | 3 = 7
  POP

  PUSH 6
  PUSH 3
  XOR      # 6 ^ 3 = 5
  POP

  PUSH 1
  PUSH 3
  SHL      # 1 << 3 = 8
  POP

  PUSH 16
  PUSH 2
  SHR      # 16 >> 2 = 4
  POP

  PUSH 5
  NOT      # ~5 = -6
  POP

  PUSH 42
  STORE RAM_PTR0   # ram[0] = 42

  PUSH RAM_PTR0
  LOADI            # pop addr 0 -> push ram[0] = 42
  POP

  PUSH 99
  PUSH RAM_PTR1
  STOREI           # pop addr 1, pop value 99 -> ram[1] = 99

  PUSH RAM_PTR1
  LOADI            # pop addr 1 -> push ram[1] = 99
  POP

  HALT
