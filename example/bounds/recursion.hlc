// Этот файл компилируется успешно, но анализатор стека обязан сообщить, что
// глубину нельзя ограничить (тест warn_hlc_recursion, см. CMakeLists.txt).
//
// Рекурсия делает максимальную глубину функцией входных данных, а не свойством
// кода: сколько раз Countdown вызовет сам себя, статически неизвестно.
int Countdown(int n) {
    if (n <= 0)
        return 0;
    return Countdown(n - 1);
}

void main() {
    Countdown(5);
    halt;
}
