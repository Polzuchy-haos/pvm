// Этот файл обязан НЕ компилироваться — он проверяет анализатор стека
// (тест reject_hlc_stack_overflow, см. CMakeLists.txt в корне).
//
// Двух слов не хватит: только кадр самой main (сохранённый FP + две локальные
// переменные) уже больше, не говоря о промежуточных значениях выражения и о
// кадре вызываемой функции.
section stack 2;

int Triple(int x) {
    return x + x + x;
}

void main() {
    int a;
    int b;

    a = 1;
    b = Triple(a);
    halt;
}
