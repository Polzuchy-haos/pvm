// Демонстрация встроенной конструкции svc(номер, аргументы...) — вызов в
// Си-код. Окружение pvmsim/pvmdbg (simulator/pvmenv.c) регистрирует SVC #0 =
// "тик системного времени" (см. lib/time.hlc + example/time_demo.hlc) и
// SVC #2 = "сложить два числа"; SVC #1 свободен.

int RESULT;

void main() {
    svc(0);                  // как оператор — результат (по конвенции SVC) отброшен
    RESULT = svc(2, 3, 4);   // как выражение — используем возвращённое значение: 7
}
