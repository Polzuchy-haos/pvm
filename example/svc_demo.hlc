// Демонстрация встроенной конструкции svc(номер, аргументы...) — вызов в
// Си-код. pvmsim регистрирует SVC #0 = "тик системного времени" (см.
// lib/time.hlc + example/time_demo.hlc), SVC #1 = "напечатать число" и
// SVC #2 = "сложить два числа" (Svc_Print/Svc_Add в simulator/pvmsim.c).

int RESULT;

void main() {
    svc(1, 42);              // как оператор — результат (по конвенции SVC) отброшен
    RESULT = svc(2, 3, 4);   // как выражение — используем возвращённое значение: 7
}
