# Проверка ENTER/LEAVE/LOADFP/STOREFP: вызов функции square(x) с аргументом
# и возвратом значения через кадр стека (frame pointer).
#
# Конвенция вызова:
#   1. Вызывающий резервирует слот под возврат:      PUSH 0
#   2. Вызывающий пушит аргументы (слева направо):   PUSH arg1 ... PUSH argN
#   3. CALL func
#   4. ENTER кладёт старый FP и открывает кадр: FP[-1]=savedFP, FP[-2]=адрес возврата,
#      FP[-3]=argN (последний запушенный, ближе к вершине), ..., FP[-(2+N)]=arg1,
#      FP[-(3+N)]=зарезервированный слот под результат.
#   5. Перед LEAVE функция кладёт результат в этот слот: STOREFP -(3+N)
#   6. LEAVE восстанавливает SP/FP, RET прыгает обратно.
#   7. Вызывающий снимает со стека N использованных копий аргументов (POP*N) —
#      после этого на вершине оказывается результат.

.entry main
.const RESULT 0

main:
  PUSH 0        # зарезервировать слот под результат
  PUSH 7        # аргумент x = 7
  CALL square
  POP           # снять использованную копию аргумента x
  STORE RESULT  # RESULT = 49
  HALT

square:
  ENTER
  LOADFP -3     # x
  LOADFP -3     # x ещё раз
  MUL           # x * x
  STOREFP -4    # записать результат в зарезервированный слот (FP[-(3+1)])
  LEAVE
  RET
