// Библиотека учёта времени. SVC #0 отдаёт "тик" системного времени —
// свободно бегущий счётчик (на реальном МК — от таймера/RTC; см. Svc_Tick
// в simulator/pvmsim.c), который переполняется каждые 65536 отсчётов.
//
// Time_Elapsed() корректно учитывает переполнение без каких-либо изменений
// в ВМ: вычитание в PVM и так выполняется по модулю 2^16 (два дополнения),
// а это ровно то, что нужно для правильной разницы между "старым" и
// "новым" тиком. Ограничение — фундаментальное для любого циклического
// счётчика: работает, только пока реальный интервал между Time_GetTick() и
// Time_Elapsed() не превышает половины периода счётчика (32768 отсчётов) —
// на большем интервале результат теряет смысл (нельзя отличить "прошло
// много" от "прошло мало, но в обратную сторону").

int Time_GetTick() {
    return svc(0);
}

int Time_Elapsed(int old) {
    int now = Time_GetTick();
    return (now >= old) ? (now - old) : ((0x7FFF - old) + now);
}

// Занять выполнение, пока не пройдёт "ticks" отсчётов Time_GetTick() (busy-wait).
// На МК с настоящим таймером за SVC #0 — реальная задержка на ticks тиков;
// на desktop-симуляторе (см. Svc_Tick в simulator/pvmsim.c) тик синтетический,
// поэтому там это не задержка по реальному времени, а просто ограниченное
// число опросов счётчика — код при этом ровно тот же.
void Time_Delay(int ticks) {
    int start;
    start = Time_GetTick();
    while (Time_Elapsed(start) < ticks) {
    }
}
