{
	"name": "pvm-lang",
	"displayName": "PVM Language Support",
	"description": "Syntax highlighting for .hlc (PVM high-level language) and .pvms (PVM assembler)",
	"version": "0.3.0",
	"publisher": "pvm-project",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": ["Programming Languages"],
	"contributes": {
		"languages": [
			{
				"id": "hlc",
				"aliases": ["PVM High-Level", "hlc"],
				"extensions": [".hlc"],
				"configuration": "./language-configuration-hlc.json"
			},
			{
				"id": "pvms",
				"aliases": ["PVM Assembly", "pvms"],
				"extensions": [".pvms"],
				"configuration": "./language-configuration-pvms.json"
			}
		],
		"grammars": [
			{
				"language": "hlc",
				"scopeName": "source.hlc",
				"path": "./syntaxes/hlc.tmLanguage.json"
			},
			{
				"language": "pvms",
				"scopeName": "source.pvms",
				"path": "./syntaxes/pvms.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "hlc",
				"path": "./snippets/hlc.json"
			}
		]
	}
}
