{
	"name": "pvm-lang",
	"displayName": "PVM Language Support",
	"description": "Syntax highlighting and source-level debugging for .hlc (PVM high-level language) and .pvms (PVM assembler)",
	"version": "0.4.0",
	"publisher": "pvm-project",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": ["Programming Languages", "Debuggers"],
	"main": "./src/extension.js",
	"activationEvents": ["onDebug"],
	"dependencies": {
		"@vscode/debugadapter": "^1.65.0"
	},
	"contributes": {
		"languages": [
			{
				"id": "hlc",
				"aliases": ["PVM High-Level", "hlc"],
				"extensions": [".hlc"],
				"configuration": "./language-configuration-hlc.json"
			},
			{
				"id": "pvms",
				"aliases": ["PVM Assembly", "pvms"],
				"extensions": [".pvms"],
				"configuration": "./language-configuration-pvms.json"
			}
		],
		"grammars": [
			{
				"language": "hlc",
				"scopeName": "source.hlc",
				"path": "./syntaxes/hlc.tmLanguage.json"
			},
			{
				"language": "pvms",
				"scopeName": "source.pvms",
				"path": "./syntaxes/pvms.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "hlc",
				"path": "./snippets/hlc.json"
			}
		],
		"breakpoints": [
			{ "language": "hlc" }
		],
		"debuggers": [
			{
				"type": "pvm",
				"label": "PVM",
				"languages": ["hlc"],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"program": {
								"type": "string",
								"description": "Compiled bytecode (.bin) to debug in a VM inside pvmdbg. Leave out when using 'port' -- a board already holds its program.",
								"default": "${workspaceFolder}/build/bytecode/blink.bin"
							},
							"port": {
								"type": "string",
								"description": "Serial port of a board running the debug agent, e.g. COM3. Without it, the program runs inside pvmdbg on this machine."
							},
							"baud": {
								"type": "number",
								"description": "Speed of 'port', 8N1. Default 9600, which the board projects use.",
								"default": 9600
							},
							"tcp": {
								"type": "string",
								"description": "host:port of a TCP connection to a board -- a bridge to its UART, or pvmboard. Instead of 'port'; like 'port', the board holds its own program."
							},
							"map": {
								"type": "string",
								"description": "Debug map from 'pvmc -g'. Guessed from 'program' when omitted; required with 'port', since the host has never seen the program on the board."
							},
							"pvmdbg": {
								"type": "string",
								"description": "Path to the pvmdbg executable.",
								"default": "pvmdbg"
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Stop on the first instruction instead of running immediately.",
								"default": true
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "pvm",
						"request": "launch",
						"name": "PVM: debug bytecode",
						"program": "${workspaceFolder}/build/bytecode/blink.bin",
						"pvmdbg": "${workspaceFolder}/Release/pvmdbg.exe",
						"stopOnEntry": true
					}
				],
				"configurationSnippets": [
					{
						"label": "PVM: debug locally",
						"description": "Run the bytecode in a VM inside pvmdbg",
						"body": {
							"type": "pvm",
							"request": "launch",
							"name": "PVM: debug bytecode",
							"program": "^\"\\${workspaceFolder}/build/bytecode/blink.bin\"",
							"pvmdbg": "^\"\\${workspaceFolder}/Release/pvmdbg.exe\"",
							"stopOnEntry": true
						}
					},
					{
						"label": "PVM: debug a board",
						"description": "Talk to a board over a serial port",
						"body": {
							"type": "pvm",
							"request": "launch",
							"name": "PVM: debug on hardware",
							"port": "COM3",
							"map": "^\"\\${workspaceFolder}/build/bytecode/blink.dbgmap\"",
							"pvmdbg": "^\"\\${workspaceFolder}/Release/pvmdbg.exe\"",
							"stopOnEntry": true
						}
					}
				]
			}
		]
	}
}
