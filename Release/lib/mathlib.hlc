// Модуль с математическими функциями. Не содержит main() — это не
// самостоятельная программа, а файл стандартной библиотеки: лежит в lib/
// рядом с исполняемым файлом компилятора и подключается через
// "import mathlib;" из любого .hlc-файла без указания пути (второй шаг
// поиска — см. docs/hlc-language.md).

int cube(int x) {
    return x * x * x;
}

int max2(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}
