{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PVM Assembly",
	"scopeName": "source.pvms",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#directives" },
		{ "include": "#labels" },
		{ "include": "#mnemonics" },
		{ "include": "#numbers" }
	],
	"repository": {
		"comments": {
			"patterns": [{ "name": "comment.line.number-sign.pvms", "match": "#.*$" }]
		},
		"directives": {
			"patterns": [
				{
					"match": "^\\s*(\\.const)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(\\S+)",
					"captures": {
						"1": { "name": "keyword.control.directive.pvms" },
						"2": { "name": "entity.name.constant.pvms" },
						"3": { "name": "constant.numeric.pvms" }
					}
				},
				{
					"match": "^\\s*(\\.entry)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.control.directive.pvms" },
						"2": { "name": "entity.name.label.pvms" }
					}
				},
				{
					"match": "^\\s*(\\.import)\\s+(.+)$",
					"captures": {
						"1": { "name": "keyword.control.directive.pvms" },
						"2": { "name": "string.unquoted.path.pvms" }
					}
				}
			]
		},
		"labels": {
			"patterns": [
				{
					"match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:",
					"captures": { "1": { "name": "entity.name.label.pvms" } }
				}
			]
		},
		"mnemonics": {
			"patterns": [
				{
					"name": "keyword.control.mnemonic.pvms",
					"match": "\\b(PUSH|POP|SWAP|DUP|ADD|SUB|MUL|DIV|EQ|LT|JMP|JZ|JNZ|LOAD|STORE|CALL|RET|LOADI|STOREI|HALT|AND|OR|XOR|SHL|SHR|NOT|ENTER|LEAVE|LOADFP|STOREFP|SVC)\\b"
				},
				{
					"name": "variable.other.operand.pvms",
					"match": "(?<=\\b(PUSH|JMP|JZ|JNZ|LOAD|STORE|CALL|LOADFP|STOREFP)\\s)[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"numbers": {
			"patterns": [
				{ "name": "constant.numeric.hex.pvms", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
				{ "name": "constant.numeric.decimal.pvms", "match": "-?\\b[0-9]+\\b" }
			]
		}
	}
}
